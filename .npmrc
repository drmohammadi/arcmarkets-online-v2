; Supply-chain policy for this repo. Verified active on npm 12.0.1 via
; `npm config get <key>` on 2026-08-07.
;
; NOTE: min-release-age is NOT an npm setting — npm silently ignores it
; (`npm config get min-release-age` returns null). It is a pnpm feature spelled
; `minimumReleaseAge`. It is kept here only to document intent and to become
; live if this repo migrates to pnpm. The 7-day floor is enforced by PROCESS:
; check `npm view <pkg>@<version> time` before adding any dependency.
; See DEPENDENCIES.md for the full write-up.
min-release-age=7

; These ARE enforced by npm.
ignore-scripts=true
save-exact=true
audit=true
fund=false
