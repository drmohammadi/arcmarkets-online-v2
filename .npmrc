; Inherits intent from the root policy; repeated here so installs run directly
; from this workspace directory are governed by the same rules.
;
; NOTE: when npm runs in workspace mode from the repo root it IGNORES this file
; ("npm warn config ignoring workspace config") — the root .npmrc governs then.
; This file only takes effect for an install executed with this dir as the cwd,
; which is what Vercel does (Root Directory = frontend).
;
; min-release-age is a no-op on npm; see the root .npmrc and DEPENDENCIES.md.
min-release-age=7

ignore-scripts=true
save-exact=true
audit=true
fund=false
