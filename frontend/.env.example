# Copy to `.env.local` and fill in. NEVER commit `.env.local`.
#
# All keys here are NEXT_PUBLIC_*, meaning they are inlined into the browser
# bundle at build time. Never put a secret in this file — nothing here is
# private. Changing any value requires a restart of `npm run dev` and a rebuild
# on Vercel; they are not read at runtime.

# ---------------------------------------------------------------------------
# WalletConnect / Reown project ID  ** REQUIRED FOR MOBILE WALLETS **
# ---------------------------------------------------------------------------
# Get one free at https://cloud.reown.com (formerly cloud.walletconnect.com).
# It is a 32-character hex string, e.g. 8f4a1c2d9e6b3a5f7c1d8e2b4a6f9c3e
#
# Leave this BLANK and the wallet picker shows only browser-injected wallets and
# Coinbase Wallet, which are the two that work without a relay. That is a
# deliberate, functional fallback — not a broken state.
#
# Set it and MetaMask, Rainbow, Trust and the WalletConnect QR option appear.
# Mobile users cannot connect MetaMask without this, because MetaMask mobile
# reaches the site through the WalletConnect relay.
#
# The value is validated as 32 hex chars. A placeholder like 'demo' or a partial
# paste is treated as blank, because an invalid ID fails at connect time — the
# wallet button just does nothing — rather than at page load, which makes it
# painful to diagnose.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---------------------------------------------------------------------------
# Site logo (optional)
# ---------------------------------------------------------------------------
# https URL of your logo image, used in the header and footer. Leave blank to
# render the built-in "A" monogram mark.
#
# Requirements: must be https (http and data: are rejected), and should be a
# square-ish PNG/SVG/WebP at 64px or larger. It is displayed in a fixed box with
# object-fit: contain, so a non-square image is letterboxed rather than
# stretched. A load failure falls back to the monogram automatically.
NEXT_PUBLIC_LOGO_URL=

# Optional: overrides the alt text / wordmark next to the logo.
NEXT_PUBLIC_SITE_NAME=

# ---------------------------------------------------------------------------
# Footer link overrides (all optional)
# ---------------------------------------------------------------------------
# About / Terms / Privacy default to this app's OWN /about, /terms and /privacy
# pages. Override with another app path (e.g. /legal/terms) or a full https URL
# if you host your own policies. An override that is neither falls back to the
# built-in page rather than rendering a dead link.
NEXT_PUBLIC_LINK_ABOUT=
NEXT_PUBLIC_LINK_TERMS=
NEXT_PUBLIC_LINK_PRIVACY=
NEXT_PUBLIC_LINK_DOCS=
NEXT_PUBLIC_LINK_CONTACT=
NEXT_PUBLIC_LINK_TWITTER=
NEXT_PUBLIC_LINK_DISCORD=

# Native-gas faucet. Distinct from the in-app test-USDC faucet button: this is
# where a wallet with zero native balance goes to get gas. Defaults to Circle's.
NEXT_PUBLIC_LINK_FAUCET=

# ---------------------------------------------------------------------------
# Arc Testnet RPC (optional, but strongly recommended)
# ---------------------------------------------------------------------------
# By default the app uses the public endpoint https://rpc.testnet.arc.io. That
# works, but it rate-limits aggressively (HTTP 429, and Cloudflare 1009 if you
# push it), which is what makes the trade-history scan slow on a first load.
# Point these at a private endpoint — Alchemy, Infura, or your own node — and the
# scan finishes in one pass.
#
#   NEXT_PUBLIC_ARC_TESTNET_RPC_URL=https://arc-testnet.g.alchemy.com/v2/YOUR_KEY
#   NEXT_PUBLIC_ARC_TESTNET_WS_URL=wss://arc-testnet.g.alchemy.com/v2/YOUR_KEY
#
# The public endpoint is ALWAYS kept as an automatic fallback, so if your private
# one is down, over quota or mistyped, the app degrades to the public node
# instead of breaking. Nothing here is required.
#
# Validation: the http value must be `https://` and the websocket value must be
# `wss://`. Plaintext http/ws is rejected — a browser on an https page blocks
# mixed content anyway, so it would fail in production while appearing to work on
# localhost. URLs containing credentials (https://user:pass@host) are rejected
# too. An invalid value silently falls back to the public endpoint.
#
#   ** READ THIS BEFORE PASTING AN API KEY **
#
# This is a NEXT_PUBLIC_ variable, so it is compiled into the JavaScript every
# visitor downloads. An API key here is PUBLIC — anyone can open devtools, read
# it, and spend your quota. This is not a flaw in this app; a browser dapp must
# reach an RPC directly, so the key has to be in the bundle.
#
# Therefore, if you use a paid provider:
#   1. Lock the key to your domain in the provider dashboard (Alchemy: app
#      settings -> allowlist your origin). This is the actual protection.
#   2. Set a spend cap.
#   3. Rotate the key if it has been pasted into a chat, ticket or commit.
# If the key must stay genuinely secret, it cannot live here — proxy the RPC
# through a server route instead and point this at your own proxy.
NEXT_PUBLIC_ARC_TESTNET_RPC_URL=
NEXT_PUBLIC_ARC_TESTNET_WS_URL=

# ---------------------------------------------------------------------------
# Arc Mainnet parameters — LEAVE BLANK until Circle publishes them.
# ---------------------------------------------------------------------------
# Mainnet is enabled only when CHAIN_ID and RPC_URL are both set, the chain ID
# parses to a non-zero number, AND the RPC URL passes the same https validation
# described above. A malformed URL leaves the app testnet-only rather than
# enabling a chain whose transport cannot work.
NEXT_PUBLIC_ARC_MAINNET_CHAIN_ID=
NEXT_PUBLIC_ARC_MAINNET_RPC_URL=
NEXT_PUBLIC_ARC_MAINNET_EXPLORER_URL=

# Deployed contract addresses are read from lib/deployments/index.json
# (generated by the contracts deploy script), not from env.
