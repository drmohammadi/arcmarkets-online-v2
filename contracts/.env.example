
  # Copy to `.env` and fill in. NEVER commit `.env`.

  # Deployer private key (0x-prefixed). Needed only for testnet/mainnet deploys.
  # Fund this address with faucet USDC: https://faucet.circle.com  (Arc Testnet)
  DEPLOYER_PRIVATE_KEY=

  # Arc Testnet RPC (Circle primary). Chain ID 5042002.
  ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io

  # Arc Mainnet — NOT LIVE YET. Fill in when Circle publishes params.
  # Leaving these blank keeps the mainnet network disabled.
  ARC_MAINNET_RPC_URL=
  ARC_MAINNET_CHAIN_ID=
  # Canonical USDC address on Arc mainnet (real USDC; no MockUSDC on mainnet).
  ARC_MAINNET_USDC_ADDRESS=